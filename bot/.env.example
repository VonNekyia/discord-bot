# Lokal: Kopie als bot/.env, Werte eintragen. In GitHub: gleichnamige Secrets
# des Repositorys. Siehe docs/benutzung/einrichtung.md.
DISCORD_BOT_TOKEN=

# Die Dev-Datenbank aus compose.yaml. Siehe docs/bot/datenbank.md.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=kitty
DB_USER=kitty
DB_PASSWORD=

# Das Dashboard; ohne die ersten beiden startet der Bot ohne API.
# Siehe docs/schnittstelle/anmeldung.md, „Umgebung“.
DISCORD_CLIENT_SECRET=
DASHBOARD_URL=
API_PORT=
