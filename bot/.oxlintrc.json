// Regeln für bot/. Die gemeinsamen stehen in ../.oxlintrc.json.
// Siehe docs/entwicklung/lint.md.
{
  "extends": ["../.oxlintrc.json"],
  "ignorePatterns": ["dist"],
  "options": {
    "maxWarnings": 14
  },
  "overrides": [
    {
      // Grenzen der Schichten. Kern und Discord-Schicht halten sie schon,
      // API und Module noch nicht: dort sind es Warnungen, bis der Umbau
      // fertig ist. Siehe docs/entwicklung/struktur.md, „Grenzen“.
      "files": ["src/kern/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." }],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./(api|discord|module)/", "message": "Der Kern kennt keine Schicht über sich." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/discord/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          { "patterns": [{ "regex": "^\\.\\./(api|module)/", "message": "Die Discord-Schicht kennt weder API noch Module." }] }
        ]
      }
    },
    {
      "files": ["src/api/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "warn",
          {
            "paths": [{ "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." }],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./module/", "message": "Die API kennt kein Modul; jedes Modul meldet seine Routen an." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/module/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "warn",
          {
            "paths": [
              { "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." },
              {
                "name": "../../discord/server.js",
                "importNames": ["guildVon"],
                "message": "Die Guild bleibt in der Discord-Schicht; Module nutzen den Griff Server."
              }
            ],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./[^./][^/]*/", "message": "Ein Modul importiert kein anderes Modul." },
              { "regex": "^\\.\\./\\.\\./api/", "message": "Ein Modul importiert die API nicht; es meldet seine Routen an." }
            ]
          }
        ]
      }
    },
    {
      // Altlasten: Casts und `!` an Eingaben von aussen. Sie sind Warnungen,
      // bis der Umbau sie beseitigt; mehr als `maxWarnings` dürfen es nicht
      // werden. Siehe docs/entwicklung/lint.md, „Altlasten“.
      "files": [
        "src/api/server.ts",
        "src/module/begruessung/begruessung.ts",
        "src/module/sprachraeume/sprachraeume.ts"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "warn",
        "typescript/no-non-null-assertion": "warn"
      }
    }
  ]
}
