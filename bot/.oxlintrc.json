// Regeln für bot/. Die gemeinsamen stehen in ../.oxlintrc.json.
// Siehe docs/entwicklung/lint.md.
{
  "extends": ["../.oxlintrc.json"],
  "ignorePatterns": ["dist"],
  "options": {
    "maxWarnings": 0
  },
  "overrides": [
    {
      // Grenzen der Schichten, je Schicht als Fehler.
      // Siehe docs/entwicklung/struktur.md, „Grenzen“.
      "files": ["src/kern/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." }],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./(api|brett|discord|module)/", "message": "Der Kern kennt keine Schicht über sich." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/discord/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          { "patterns": [{ "regex": "^\\.\\./(api|brett|module)/", "message": "Die Discord-Schicht kennt weder API noch Board noch Module." }] }
        ]
      }
    },
    {
      "files": ["src/api/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." }],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./(brett|module)/", "message": "Die API kennt kein Modul und nicht das Board; jedes meldet seine Routen an." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/brett/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [{ "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." }],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./(api|module)/", "message": "Das Board kennt kein Modul und nicht die API; es liest nur ihre Schalter." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/module/**"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "discord.js", "message": "Nur src/discord/ spricht mit discord.js." },
              {
                "name": "../../discord/server.js",
                "importNames": ["guildVon"],
                "message": "Die Guild bleibt in der Discord-Schicht; Module nutzen den Griff Server."
              }
            ],
            "patterns": [
              { "group": ["@discordjs/*"], "message": "Nur src/discord/ spricht mit discord.js." },
              { "regex": "^\\.\\./[^./][^/]*/", "message": "Ein Modul importiert kein anderes Modul." },
              { "regex": "^\\.\\./\\.\\./api/", "message": "Ein Modul importiert die API nicht; es meldet seine Routen an." },
              { "regex": "^\\.\\./\\.\\./brett/", "message": "Ein Modul kennt das Board nicht; es meldet seinen Schalter an." }
            ]
          }
        ]
      }
    }
  ]
}
