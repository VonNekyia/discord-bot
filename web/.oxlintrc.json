// Regeln für web/. Die gemeinsamen stehen in ../.oxlintrc.json.
// Siehe docs/entwicklung/lint.md.
{
  "extends": ["../.oxlintrc.json"],
  "ignorePatterns": ["dist"],
  "env": { "browser": true },
  "options": {
    "maxWarnings": 4
  },
  "overrides": [
    {
      // Grenzen der Schichten. Siehe docs/entwicklung/struktur.md, „Grenzen“.
      "files": ["src/**"],
      "excludeFiles": ["src/api/**"],
      "rules": {
        "eslint/no-restricted-globals": ["error", { "name": "fetch", "message": "Nur src/api/ spricht mit dem Bot." }]
      }
    },
    {
      "files": ["src/api/**"],
      "rules": {
        "eslint/no-restricted-imports": ["error", { "patterns": [{ "regex": "^\\.", "message": "Die API-Schicht importiert nichts Eigenes." }] }]
      }
    },
    {
      "files": ["src/kern/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          { "patterns": [{ "regex": "^\\.\\./(bausteine/|seite|dashboard|main)", "message": "Der Kern kennt keine Bausteine, keine Seite und nicht das Dashboard." }] }
        ]
      }
    },
    {
      "files": ["src/bausteine/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "^\\./", "message": "Ein Baustein importiert keinen anderen; eine Liste baut ihre Einträge über die Umgebung." },
              { "regex": "^\\.\\./bausteine/", "message": "Ein Baustein importiert keinen anderen; eine Liste baut ihre Einträge über die Umgebung." },
              { "regex": "^\\.\\./(seite|dashboard|main)", "message": "Ein Baustein kennt die Seite nicht; die Seite bindet die Bausteine ein." }
            ]
          }
        ]
      }
    },
    {
      // Altlasten: Casts an Antworten der API und an getElementById. Sie sind
      // Warnungen, bis der Umbau sie beseitigt; mehr als `maxWarnings`
      // dürfen es nicht werden. Siehe docs/entwicklung/lint.md, „Altlasten“.
      "files": ["src/api/klient.ts", "src/dashboard.ts"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "warn",
        "typescript/no-unnecessary-type-parameters": "warn"
      }
    }
  ]
}
